      { title: "Autres Confiseries", id: "confiserie-diverse", image: "https://plus.unsplash.com/premium_photo-1674819643863-7c9e5fe09297?q=60&w=600&auto=format&fit=crop", desc: "Caramels, pâtes de fruits." }
    ]
  },
  'cuisine': {
