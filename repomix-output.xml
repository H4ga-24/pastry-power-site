export const GLOSSARY = {
  "abaisser": "Étaler une pâte à l'épaisseur voulue à l'aide d'un rouleau à pâtisserie ou d'un laminoir.",
  "fraser": "Écraser la pâte avec la paume de la main pour mélanger les ingrédients sans lui donner de corps (sans activer le gluten).",
  "chemiser": "Appliquer, contre les parois et le fond d'un moule, une couche de papier cuisson, de beurre et farine, ou de biscuit.",
  "foisonner": "Fouetter une préparation (crème, œufs) pour incorporer de l'air et augmenter son volume.",
  "ruban": "Se dit d'une préparation (souvent œufs + sucre) qui coule de manière continue et épaisse comme un ruban quand on soulève le fouet.",
  "vanner": "Remuer une sauce ou une crème pendant son refroidissement pour éviter la formation d'une peau en surface.",
  "macaronner": "Mélanger délicatement la pâte à macarons pour la faire retomber légèrement et la rendre brillante.",
  "blanchir": "Fouetter vigoureusement des jaunes d'œufs et du sucre jusqu'à ce que le mélange devienne pâle et mousseux.",
  "chablonner": "Enduire la base d'un gâteau ou d'un biscuit d'une fine couche de chocolat fondu pour l'imperméabiliser.",
  "parer": "Couper les entames ou les parties inutiles d'un produit pour lui donner une forme régulière."
};
</file>

